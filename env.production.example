# Copy this file to .env on the GoDaddy server (inside the repo folder, next to artisan).
# Then run:  php artisan key:generate && php artisan migrate --force && php artisan storage:link && php artisan config:cache

APP_NAME=PostPilot
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tool.fxshams.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel → MySQL Databases: names are prefixed with your cPanel username, e.g. cpuser_postingtool
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_postingtool
DB_USERNAME=cpuser_postingtool
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" because shared hosting has no queue worker. The app does not queue anything.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@fxshams.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
